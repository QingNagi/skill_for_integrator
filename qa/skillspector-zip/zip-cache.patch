+def _read_zip_candidate(path: Path, prefix_limit: int, expected_size: int) -> bytes:
+    """Read a ZIP envelope from one descriptor. Other artifacts keep their static prefix."""
+    with _open_regular_file_no_follow(path) as source:
+        before = os.fstat(source.fileno())
+        prefix = source.read(prefix_limit + 1)
+        if len(prefix) <= prefix_limit or not is_zip_content(prefix):
+            return prefix
+        if before.st_size != expected_size:
+            raise OSError("Archive changed before its envelope could be read")
+        tail = source.read(expected_size - len(prefix) + 1)
+        after = os.fstat(source.fileno())
+        if (
+            len(prefix) + len(tail) != expected_size
+            or after.st_size != before.st_size
+            or after.st_mtime_ns != before.st_mtime_ns
+        ):
+            raise OSError("Archive changed while reading its envelope")
+        return prefix + tail
+
