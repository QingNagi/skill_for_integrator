diff --git a/tests/nodes/test_zip_cache_extent.py b/tests/nodes/test_zip_cache_extent.py
new file mode 100644
index 0000000..d47f9f1
--- /dev/null
+++ b/tests/nodes/test_zip_cache_extent.py
@@ -0,0 +1,65 @@
+"""Regression cases for full ZIP envelopes and ordinary prefix projections."""
+import importlib
+import zipfile
+
+import pytest
+
+from skillspector.nodes.build_context import build_context
+
+
+def scan(tmp_path, monkeypatch, *, total=32_768, broken=False):
+    module = importlib.import_module("skillspector.nodes.build_context")
+    monkeypatch.setattr(module, "MAX_ANALYZABLE_FILE_BYTES", 256)
+    monkeypatch.setattr(module, "MAX_TOTAL_CACHED_BYTES", total)
+    (tmp_path / "SKILL.md").write_text("---\nname: sample\ndescription: Sample\n---\n", encoding="utf-8")
+    wheel = tmp_path / "sample.whl"
+    if broken:
+        wheel.write_bytes(b"PK\x03\x04" + b"X" * 512)
+    else:
+        with zipfile.ZipFile(wheel, "w") as archive:
+            archive.writestr("sample/notes.txt", b"abcdefgh" * 64)
+            archive.writestr("sample/module.py", b"label = 'archive member'\n")
+    result = build_context({"skill_path": str(tmp_path), "source_local_only": True})
+    reasons = {
+        e["reason_code"] for e in result["inspection_ledger"] if e.get("path") == wheel.name
+    }
+    return result, reasons
+
+
+def test_zip_central_directory_after_the_static_prefix(tmp_path, monkeypatch):
+    result, reasons = scan(tmp_path, monkeypatch)
+    assert "sample.whl!/sample/module.py" in result["raw_file_cache"]
+    assert len(result["raw_file_cache"]["sample.whl"]) == 256
+    assert "size_limit" in reasons
+    assert "archive_malformed" not in reasons
+
+
+def test_known_incomplete_zip_records_the_limit(tmp_path, monkeypatch):
+    result, reasons = scan(tmp_path, monkeypatch, total=512)
+    assert "archive_size_limit" in reasons
+    assert "archive_malformed" not in reasons
+    assert "sample.whl!/sample/module.py" not in result["raw_file_cache"]
+
+
+def test_complete_but_invalid_zip_keeps_the_parser_failure(tmp_path, monkeypatch):
+    _, reasons = scan(tmp_path, monkeypatch, broken=True)
+    assert "archive_malformed" in reasons
+
+
+def test_archive_input_limit_is_independent_of_bundle_space(tmp_path, monkeypatch):
+    module = importlib.import_module("skillspector.nodes.build_context")
+    monkeypatch.setattr(module, "ARCHIVE_MAX_UNCOMPRESSED_BYTES", 512)
+    result, reasons = scan(tmp_path, monkeypatch)
+    assert "archive_size_limit" in reasons
+    assert "archive_malformed" not in reasons
+    assert "sample.whl!/sample/module.py" not in result["raw_file_cache"]
+
+
+def test_non_zip_keeps_prefix_and_zip_size_change_is_rejected(tmp_path):
+    module = importlib.import_module("skillspector.nodes.build_context")
+    candidate = tmp_path / "candidate"
+    candidate.write_bytes(b"A" * 128)
+    assert len(module._read_zip_candidate(candidate, 16, 128)) == 17
+    candidate.write_bytes(b"PK\x03\x04" + b"A" * 128)
+    with pytest.raises(OSError, match="changed"):
+        module._read_zip_candidate(candidate, 16, 128)
